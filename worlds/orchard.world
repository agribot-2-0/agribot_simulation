<?xml version="1.0" ?>
<sdf version="1.6">
  <world name="default">

    <gui fullscreen='0'>
      <camera name='user_camera'>
        <pose frame=''>-30 -20 30 0 0.6 0.3</pose>
        <view_controller>orbit</view_controller>
        <projection_type>perspective</projection_type>
      </camera>
    </gui>

    <!-- A grass plane -->
    <population name="grass_plane">
      <model name="grass">
        <include>
          <uri>model://grass_plane</uri>
        </include>
      </model>
      <pose>15 -8 0 0 0 0</pose>
      <distribution>
        <type>grid</type>
        <rows>4</rows>
        <cols>4</cols>
        <step>10 10 0</step>
      </distribution>
    </population>

    <!-- Trees -->
    <population name="tree_population">
      <model name="tree">
        <include>
          <uri>model://tree</uri>
        </include>
      </model>
      <pose>14 -8 0 0 0 0</pose>
      <distribution>
        <type>grid</type>
        <rows>6</rows>
        <cols>20</cols>
        <step>1 4 0</step>
      </distribution>
    </population>

  </world>
</sdf>
