<launch>
  <arg name="world" default="vineyard"/>

  <include file="$(find agribot_simulation)/launch/agribot_simulation.launch">
      <arg name="world" value="${vineyard}" />
      <arg name="gazebo_gui" value="false" />
      <arg name="gazebo_debug" value="false" />
      <arg name="perception_sensors" value="true" />
  </include>


</launch>
