<launch>
  <param name="/use_sim_time" value="true" />

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find agribot_simulation)/worlds/$(env AGRIBOT_SIMULATION_WORLD).world" />
    <arg name="gui" value="$(env AGRIBOT_SIMULATION_GAZEBO_GUI)" />
    <arg name="debug" value="$(env AGRIBOT_SIMULATION_GAZEBO_DEBUG)" />
  </include>

  <include file="$(find agribot_description)/launch/spawn_agribot.launch"/>

  <include if="$(env AGRIBOT_SIMULATION_MOBILE_APP)" file="$(find agribot_simulation)/launch/mobile_app_simulator.launch" />

</launch>
