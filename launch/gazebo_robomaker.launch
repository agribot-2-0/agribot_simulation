<launch>
  <arg name="world" default="vineyard"/>

  <include file="$(find gazebo_ros)/launch/empty_world.launch">
    <arg name="world_name" value="$(find agribot_simulation)/worlds/$(arg world).world"/>
    <arg name="paused" value="false"/>
    <arg name="use_sim_time" value="true"/>
    <arg name="gui" value="false"/>
    <arg name="headless" value="true"/>
    <arg name="debug" value="false"/>
  </include>

  <include file="$(find agribot_simulation)/launch/mobile_app_simulator.launch" />
  <include file="$(find agribot_description)/launch/spawn_agribot.launch" />

</launch>
