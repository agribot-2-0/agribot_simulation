<?xml version="1.0"?>
<package format="2">
  <name>agribot_simulation</name>
  <version>0.0.0</version>
  <description>The agribot_simulation package</description>

  <!-- One maintainer tag required, multiple allowed, one person per tag -->
  <!-- Example:  -->
  <!-- <maintainer email="jane.doe@example.com">Jane Doe</maintainer> -->
  <maintainer email="l.chojnacki@agribot.eu">Łukasz Chojnacki</maintainer>
  <maintainer email="m.wiadomski@agribot.eu">Michał Wiadomski</maintainer>


  <license>Proprietary</license>


  <buildtool_depend>catkin</buildtool_depend>
  <build_depend>gazebo</build_depend>
  <build_depend>gazebo_ros</build_depend>
  <build_depend>geometry_msgs</build_depend>
  <build_depend>agribot_common</build_depend>
  <build_depend>agribot_msgs</build_depend>
  <build_depend>nav_msgs</build_depend>
  <build_depend>roscpp</build_depend>
  <build_depend>tf</build_depend>
  <build_depend>hector_gazebo_plugins</build_depend>
  <build_depend>gazebo_plugins</build_depend>
  <build_depend>industrial_msgs</build_depend>
  <build_export_depend>gazebo_ros</build_export_depend>
  <build_export_depend>gazebo</build_export_depend>
  <build_export_depend>geometry_msgs</build_export_depend>
  <!-- <build_export_depend>agribot_msgs</build_export_depend> -->
  <build_export_depend>nav_msgs</build_export_depend>
  <build_export_depend>roscpp</build_export_depend>
  <build_export_depend>tf</build_export_depend>
  <build_export_depend>hector_gazebo_plugins</build_export_depend>
  <build_export_depend>gazebo_plugins</build_export_depend>
  <build_export_depend>industrial_msgs</build_export_depend>
  <exec_depend>gazebo</exec_depend>
  <exec_depend>gazebo_ros</exec_depend>
  <exec_depend>geometry_msgs</exec_depend>
  <!-- <exec_depend>agribot_msgs</exec_depend> -->
  <exec_depend>nav_msgs</exec_depend>
  <exec_depend>roscpp</exec_depend>
  <exec_depend>tf</exec_depend>
  <exec_depend>hector_gazebo_plugins</exec_depend>
  <exec_depend>gazebo_plugins</exec_depend>
  <exec_depend>industrial_msgs</exec_depend>
  <exec_depend>agribot_common</exec_depend>


  <!-- The export tag contains other, unspecified, tags -->
  <export>
    <!-- Other tools can request additional information be placed here -->
    <gazebo_ros gazebo_model_path="${prefix}/models"/>
    <gazebo_ros gazebo_media_path="${prefix}/worlds"/>
  </export>
</package>
